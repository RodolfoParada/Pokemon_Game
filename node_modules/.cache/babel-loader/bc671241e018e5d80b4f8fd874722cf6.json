{"ast":null,"code":"export default {\n  props: {\n    pokemons: {\n      type: Array,\n      required: true\n    },\n    answerId: {\n      type: Number,\n      required: true\n    }\n  },\n  data() {\n    return {\n      selectedId: null // Guardamos cuál clickeó el usuario\n    };\n  },\n\n  methods: {\n    onSelect(id) {\n      if (this.selectedId !== null) return; // Evita múltiples clics\n      this.selectedId = id;\n      this.$emit('selection', id);\n    }\n  },\n  watch: {\n    // Si los pokemons cambian (Nuevo Juego), reseteamos el seleccionado\n    pokemons() {\n      this.selectedId = null;\n    }\n  }\n};","map":{"version":3,"mappings":"AAwBE,eAAe;EACbA,KAAK,EAAE;IACLC,QAAQ,EAAE;MACRC,IAAI,EAAEC,KAAK;MACXC,QAAQ,EAAC;IACX,CAAC;IACDC,QAAQ,EAAE;MACRH,IAAI,EAAEI,MAAM;MACXF,QAAQ,EAAE;IACb;EACF,CAAC;EACLG,IAAI,GAAG;IACH,OAAO;MACLC,UAAU,EAAE,IAAG,CAAE;IACnB;EACF,CAAC;;EACDC,OAAO,EAAE;IACPC,QAAQ,CAACC,EAAE,EAAE;MACX,IAAI,IAAI,CAACH,UAAS,KAAM,IAAI,EAAE,OAAM,CAAE;MACtC,IAAI,CAACA,UAAS,GAAIG,EAAE;MACpB,IAAI,CAACC,KAAK,CAAC,WAAW,EAAED,EAAE,CAAC;IAC7B;EACF,CAAC;EACDE,KAAK,EAAE;IACL;IACAZ,QAAQ,GAAG;MACT,IAAI,CAACO,UAAS,GAAI,IAAI;IACxB;EACF;AAGA","names":["props","pokemons","type","Array","required","answerId","Number","data","selectedId","methods","onSelect","id","$emit","watch"],"sourceRoot":"","sources":["/home/trimogesimo/a-subir/Pokemon_Game/src/components/PokemonOptions.vue"],"sourcesContent":["<template>\r\n    <div class=\"options-container\">\r\n      <ul>\r\n        <li v-for=\"pokemon in pokemons\" \r\n            :key=\"pokemon.id\"\r\n            @click=\"onSelect(pokemon.id)\"\r\n        :class=\"[\r\n          'option-item', \r\n          { \r\n            'correct': selectedId === pokemon.id && pokemon.id === answerId,\r\n            'incorrect': selectedId === pokemon.id && pokemon.id !== answerId,\r\n            'disabled': selectedId !== null\r\n          }\r\n        ]\"\r\n            \r\n            >\r\n            {{ pokemon.name }}\r\n        </li>\r\n       \r\n      </ul>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  export default {\r\n    props: {\r\n      pokemons: {\r\n        type: Array,\r\n        required:true\r\n      },\r\n      answerId: { \r\n        type: Number,\r\n         required: true\r\n      }\r\n    },\r\ndata() {\r\n    return {\r\n      selectedId: null // Guardamos cuál clickeó el usuario\r\n    }\r\n  },\r\n  methods: {\r\n    onSelect(id) {\r\n      if (this.selectedId !== null) return; // Evita múltiples clics\r\n      this.selectedId = id;\r\n      this.$emit('selection', id);\r\n    }\r\n  },\r\n  watch: {\r\n    // Si los pokemons cambian (Nuevo Juego), reseteamos el seleccionado\r\n    pokemons() {\r\n      this.selectedId = null;\r\n    }\r\n  }\r\n\r\n  \r\n  }\r\n  </script>\r\n  \r\n  <style scope>\r\n\r\n  .options-container {\r\n    display: flex;\r\n    justify-content: center;\r\n    margin-top: -15%;\r\n     }\r\n  ul {\r\n    list-style-type: none; \r\n    margin-top: 17%;\r\n  }\r\n \r\n  li {\r\n    background-color: white;\r\n    border-radius: 5px;\r\n    border: 1px solid rgba(0, 0, 0, 0.2);\r\n    cursor: pointer;\r\n    margin-bottom: 10px;\r\n    width: 250px;\r\n    \r\n  }\r\n\r\nli:hover {\r\n    background-color: rgba(0, 0, 0, 0.05);\r\n}\r\n\r\n\r\n  \r\n  </style>"]},"metadata":{},"sourceType":"module"}