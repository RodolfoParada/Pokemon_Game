{"ast":null,"code":"export default {\n  props: {\n    pokemons: {\n      type: Array,\n      required: true\n    },\n    answerId: {\n      type: Number,\n      required: true\n    } // Recibimos el ID correcto del padre\n  },\n\n  data() {\n    return {\n      selectedId: null // Guardamos cuál clickeó el usuario\n    };\n  },\n\n  methods: {\n    onSelect(id) {\n      if (this.selectedId !== null) return; // Evita múltiples clics\n      this.selectedId = id;\n      this.$emit('selection', id);\n    }\n  },\n  watch: {\n    // Si los pokemons cambian (Nuevo Juego), reseteamos el seleccionado\n    pokemons() {\n      this.selectedId = null;\n    }\n  }\n};","map":{"version":3,"mappings":"AAuBA,eAAe;EACbA,KAAK,EAAE;IACLC,QAAQ,EAAE;MAAEC,IAAI,EAAEC,KAAK;MAAEC,QAAQ,EAAE;IAAK,CAAC;IACzCC,QAAQ,EAAE;MAAEH,IAAI,EAAEI,MAAM;MAAEF,QAAQ,EAAE;IAAK,EAAE;EAC7C,CAAC;;EACDG,IAAI,GAAG;IACL,OAAO;MACLC,UAAU,EAAE,IAAG,CAAE;IACnB;EACF,CAAC;;EACDC,OAAO,EAAE;IACPC,QAAQ,CAACC,EAAE,EAAE;MACX,IAAI,IAAI,CAACH,UAAS,KAAM,IAAI,EAAE,OAAM,CAAE;MACtC,IAAI,CAACA,UAAS,GAAIG,EAAE;MACpB,IAAI,CAACC,KAAK,CAAC,WAAW,EAAED,EAAE,CAAC;IAC7B;EACF,CAAC;EACDE,KAAK,EAAE;IACL;IACAZ,QAAQ,GAAG;MACT,IAAI,CAACO,UAAS,GAAI,IAAI;IACxB;EACF;AACF","names":["props","pokemons","type","Array","required","answerId","Number","data","selectedId","methods","onSelect","id","$emit","watch"],"sourceRoot":"","sources":["/home/trimogesimo/a-subir/Pokemon_Game/src/components/PokemonOptions.vue"],"sourcesContent":["<template>\r\n  <div class=\"options-container\">\r\n    <ul>\r\n      <li \r\n        v-for=\"pokemon in pokemons\" \r\n        :key=\"pokemon.id\"\r\n        @click=\"onSelect(pokemon.id)\"\r\n        :class=\"[\r\n          'option-item', \r\n          { \r\n            'correct': selectedId === pokemon.id && pokemon.id === answerId,\r\n            'incorrect': selectedId === pokemon.id && pokemon.id !== answerId,\r\n            'disabled': selectedId !== null\r\n          }\r\n        ]\"\r\n      >\r\n        {{ pokemon.name }}\r\n      </li>\r\n    </ul>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  props: {\r\n    pokemons: { type: Array, required: true },\r\n    answerId: { type: Number, required: true } // Recibimos el ID correcto del padre\r\n  },\r\n  data() {\r\n    return {\r\n      selectedId: null // Guardamos cuál clickeó el usuario\r\n    }\r\n  },\r\n  methods: {\r\n    onSelect(id) {\r\n      if (this.selectedId !== null) return; // Evita múltiples clics\r\n      this.selectedId = id;\r\n      this.$emit('selection', id);\r\n    }\r\n  },\r\n  watch: {\r\n    // Si los pokemons cambian (Nuevo Juego), reseteamos el seleccionado\r\n    pokemons() {\r\n      this.selectedId = null;\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* ... tus estilos anteriores ... */\r\n\r\n.option-item {\r\n  background-color: white;\r\n  transition: background-color 0.3s;\r\n}\r\n\r\n.correct {\r\n  background-color: #a5d6a7 !important; /* Verde suave */\r\n  border-color: #4caf50 !important;\r\n}\r\n\r\n.incorrect {\r\n  background-color: #ef9a9a !important; /* Rojo suave */\r\n  border-color: #f44336 !important;\r\n}\r\n\r\n.disabled {\r\n  pointer-events: none; /* Bloquea clics después de responder */\r\n}\r\n</style>"]},"metadata":{},"sourceType":"module"}