{"ast":null,"code":"import PokemonPicture from '@/components/PokemonPicture';\nimport PokemonOptions from '@/components/PokemonOptions';\nimport getPokemonOptions from '@/helpers/getPokemonOptions';\n// import { threadId } from 'worker_threads';\n\nconsole.log(getPokemonOptions());\nexport default {\n  components: {\n    PokemonPicture,\n    PokemonOptions\n  },\n  data() {\n    return {\n      pokemonArr: [],\n      pokemon: null,\n      showPokemon: false,\n      showAnswer: false,\n      message: ''\n    };\n  },\n  methods: {\n    async mixPokemonArray() {\n      this.pokemonArr = await getPokemonOptions();\n      const rndInt = Math.floor(Math.random() * 4);\n      this.pokemon = this.pokemonArr[rndInt];\n    },\n    checkAnswer(selectedId) {\n      this.showPokemon = true;\n      this.showAnswer = true;\n      if (selectedId === this.pokemon.id) {\n        this.message = `Correcto, ${this.pokemon.name}`;\n      } else {\n        this.message = `Lo lamento!! intentalo otra vez`;\n      }\n    },\n    newGame() {\n      this.showPokemon = false;\n      this.showAnswer = false;\n      this.pokemonArr = [];\n      this.pokemon = null;\n      this.mixPokemonArray();\n    }\n  },\n  mounted() {\n    this.mixPokemonArray();\n  }\n};","map":{"version":3,"mappings":"AA+BA,OAAOA,cAAa,MAAO,6BAA6B;AACxD,OAAOC,cAAa,MAAO,6BAA6B;AAExD,OAAOC,iBAAgB,MAAO,6BAA6B;AAC3D;;AAEAC,OAAO,CAACC,GAAG,CAACF,iBAAiB,EAAE;AAG/B,eAAe;EACXG,UAAU,EAAE;IAAEL,cAAc;IAAEC;EAAe,CAAC;EAC9CK,IAAI,GAAG;IACL,OAAO;MACLC,UAAU,EAAC,EAAC;MACZC,OAAO,EAAE,IAAI;MACbC,WAAW,EAAE,KAAK;MAClBC,UAAU,EAAE,KAAK;MACjBC,OAAO,EAAC;IACV;EACF,CAAC;EACDC,OAAO,EAAC;IACP,MAAMC,eAAe,GAAG;MACpB,IAAI,CAACN,UAAS,GAAI,MAAML,iBAAiB,EAAC;MAE1C,MAAMY,MAAK,GAAIC,IAAI,CAACC,KAAK,CAAED,IAAI,CAACE,MAAM,EAAC,GAAI,EAAE;MAC7C,IAAI,CAACT,OAAM,GAAI,IAAI,CAACD,UAAU,CAACO,MAAM;IAExC,CAAC;IACDI,WAAW,CAACC,UAAS,EAAG;MACtB,IAAI,CAACV,WAAU,GAAI,IAAG;MACtB,IAAI,CAACC,UAAS,GAAI,IAAG;MAErB,IAAGS,UAAS,KAAM,IAAI,CAACX,OAAO,CAACY,EAAE,EAAE;QACjC,IAAI,CAACT,OAAM,GAAK,aAAY,IAAI,CAACH,OAAO,CAACa,IAAM;MAElD,CAAC,MAAI;QACJ,IAAI,CAACV,OAAM,GAAI,iCAA+B;MAE9C;IACF,CAAC;IACDW,OAAO,GAAE;MAEP,IAAI,CAACb,WAAU,GAAI,KAAI;MACvB,IAAI,CAACC,UAAS,GAAI,KAAI;MACtB,IAAI,CAACH,UAAS,GAAI,EAAC;MACnB,IAAI,CAACC,OAAM,GAAI,IAAG;MAClB,IAAI,CAACK,eAAe,EAAC;IAEvB;EACF,CAAC;EACFU,OAAO,GAAE;IACN,IAAI,CAACV,eAAe,EAAC;EACrB;AAIF","names":["PokemonPicture","PokemonOptions","getPokemonOptions","console","log","components","data","pokemonArr","pokemon","showPokemon","showAnswer","message","methods","mixPokemonArray","rndInt","Math","floor","random","checkAnswer","selectedId","id","name","newGame","mounted"],"sourceRoot":"","sources":["/home/trimogesimo/a-subir/Pokemon_Game/src/pages/PokemonPage.vue"],"sourcesContent":["<template>\r\n\r\n    <h1 v-if=\"!pokemon\">Espere por favor...</h1>\r\n\r\n\r\n <div v-else>\r\n   <h1>¿Quién es este pokemon?</h1>\r\n\r\n  <!--pokemonId lo recibe props de en PokemonId-->\r\n  <PokemonPicture  :pokemonId=\"pokemon.id\" :showPokemon=\"showPokemon\"/>\r\n  <PokemonOptions\r\n            :pokemons=\"pokemonArr \"\r\n            @selection=\"checkAnswer\"\r\n            />\r\n\r\n      <template v-if=\"showAnswer\">\r\n      <h2 class=\"fade-in\">{{ message }}</h2>\r\n\r\n       <button @click=\"newGame\">\r\n        Nuevo Juego\r\n        </button>\r\n      </template>\r\n\r\n </div>\r\n\r\n\r\n</template>\r\n\r\n<script>\r\n\r\n\r\nimport PokemonPicture from '@/components/PokemonPicture';\r\nimport PokemonOptions from '@/components/PokemonOptions';\r\n\r\nimport getPokemonOptions from '@/helpers/getPokemonOptions';\r\n// import { threadId } from 'worker_threads';\r\n\r\nconsole.log(getPokemonOptions())\r\n\r\n\r\nexport default {\r\n    components: { PokemonPicture, PokemonOptions },\r\n    data() {\r\n      return {\r\n        pokemonArr:[] ,\r\n        pokemon: null,\r\n        showPokemon: false,\r\n        showAnswer: false,\r\n        message:''\r\n      }\r\n    },\r\n    methods:{\r\n     async mixPokemonArray() {\r\n         this.pokemonArr = await getPokemonOptions()\r\n       \r\n         const rndInt = Math.floor( Math.random() * 4 )\r\n         this.pokemon = this.pokemonArr[rndInt]\r\n     \r\n      },\r\n      checkAnswer(selectedId ){\r\n        this.showPokemon = true\r\n        this.showAnswer = true\r\n\r\n        if(selectedId === this.pokemon.id) {\r\n          this.message = `Correcto, ${this.pokemon.name }`\r\n       \r\n       }else{\r\n        this.message =`Lo lamento!! intentalo otra vez` \r\n          \r\n        }\r\n      },\r\n      newGame(){\r\n\r\n        this.showPokemon = false\r\n        this.showAnswer = false\r\n        this.pokemonArr = []\r\n        this.pokemon = null\r\n        this.mixPokemonArray()\r\n\r\n      }\r\n    },\r\n   mounted(){\r\n      this.mixPokemonArray()\r\n      }\r\n\r\n\r\n\r\n    }\r\n\r\n\r\n</script>\r\n\r\n<style>\r\n\r\n</style>"]},"metadata":{},"sourceType":"module"}